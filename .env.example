# =========================================================
# RAIFY - Modelo de configuração (copie para ".env" e preencha).
#
# Todos os valores abaixo você encontra em:
# Console Firebase > Configurações do projeto > Geral > Seus apps > (ícone Web </>)
#
# Estes valores são PÚBLICOS por natureza (fazem parte do app que
# roda no navegador/celular de qualquer pessoa). A segurança de
# verdade está nos arquivos firestore.rules e storage.rules.
#
# O arquivo ".env" (preenchido) fica fora do Git de propósito — veja
# o .gitignore. Este ".env.example" é o modelo versionado.
# =========================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# (Opcional) Endereço do APK usado no QR code da tela de login.
# Se vazio, usa <endereço do site>/download/RAIFY.apk (pasta public/download).
VITE_APK_URL=
